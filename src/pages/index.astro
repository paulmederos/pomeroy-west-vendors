---
import Base from '../layouts/Base.astro';
import { allVendors as vendors, categoryChips, vendorCount as count } from '../lib/data.mjs';

// Problem-word synonyms, keyed off the exact category vocabulary so they don't bleed
// (e.g. a Plumber's "drain cleaning" service must NOT make it match "house cleaner").
const CAT_SYNONYMS = {
  'Plumber': 'leak leaking drain clog clogged pipe sewer toilet faucet sink valve shutoff backup',
  'Cleaner': 'cleaners cleaning housekeeper housekeeping maid house',
  'Electrician': 'electric electrical wiring panel outlet breaker socket lighting ev charger',
  'Radiant Heat': 'boiler heater heating furnace tankless hydronic radiant',
  'Handyman': 'handyperson repair fix odd jobs fixture',
  'Gardener': 'garden yard lawn mow mowing landscape landscaping weeds',
  'Arborist': 'tree trees trim trimming prune pruning stump branches',
  'General Contractor': 'remodel renovation construction addition',
  'Windows & Glass': 'window windows pane screen sliding door mirror glazing',
  'Concrete': 'driveway slab patio cement',
  'HVAC': 'ac air conditioning conditioner cooling heat pump mini-split minisplit furnace',
  'Kitchen Reface': 'cabinet cabinets kitchen reface remodel',
  'Water Softener': 'softener filter filtration hard water conditioning',
  'Auto Repair': 'car mechanic auto vehicle',
  'Babysitter & Helper': 'babysitter nanny childcare sitter helper',
  'Flooring': 'floor floors laminate hardwood tile carpet vinyl refinish',
};

function keywords(v) {
  return v.categories.map((c) => CAT_SYNONYMS[c.label] || '').filter(Boolean).join(' ');
}

// Full searchable blob: name, contact, trades, services, neighbor review text, notes, synonyms.
function searchString(v) {
  return [
    v.name,
    v.contact,
    ...v.categories.map((c) => c.label),
    ...v.services.map((s) => s.label),
    ...(v.reviews || []).map((r) => r.text),
    ...(v.notes || []),
    keywords(v),
  ].filter(Boolean).join(' ').toLowerCase();
}

const phoneIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>';
---

<Base description="Browse, filter, and search contractors and services recommended by Pomeroy West neighbors.">
  <section class="wrap hero">
    <h1>Neighbors' trusted vendors</h1>
    <p>Plumbers, gardeners, electricians and more — vouched for by your Pomeroy West neighbors.</p>
    <p class="hero-source">Built from recommendations neighbors post in the <a href="https://groups.google.com/g/pomeroywest" target="_blank" rel="noopener noreferrer">Pomeroy West Google Group</a> — recommend a vendor there and they’ll be added here.</p>
  </section>

  <div class="wrap layout">
    <aside class="sidebar">
      <div class="search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search" type="search" placeholder="Search name or service…" autocomplete="off" aria-label="Search vendors" />
      </div>

      <button class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filters">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
        <span>Category: <strong id="filter-label">All</strong></span>
        <svg class="caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>

      <nav class="filters" id="filters" aria-label="Filter by category">
        <button class="chip" data-cat="all" data-label="All" aria-pressed="true"><span class="c-ic" aria-hidden="true">🏘️</span><span class="c-label">All vendors</span><span class="count">{count}</span></button>
        {categoryChips.map((c) => (
          <button class="chip" data-cat={c.label} data-label={c.label} aria-pressed="false">
            <span class="c-ic" aria-hidden="true">{c.icon}</span><span class="c-label">{c.label}</span><span class="count">{c.count}</span>
          </button>
        ))}
      </nav>
    </aside>

    <main class="results">
      <details class="hoa-note">
        <summary>
          🛠️ <strong>Many home repairs are HOA-covered</strong> — <span class="hoa-toggle">see what the Association handles<span class="caret">▾</span></span>
        </summary>
        <div class="hoa-body">
          <p>Before calling a vendor for any of these, it’s likely the <strong>Association’s</strong> job (and cost):</p>
          <ul>
            <li><strong>Roofs</strong> — leaks, coating, repair &amp; replacement (plus atrium roofs, gutters, eaves &amp; fascia)</li>
            <li><strong>Exterior walls &amp; paint</strong> — siding, structure, and all exterior painting</li>
            <li><strong>Outside of windows &amp; doors</strong> — exterior frames, weatherstripping, caulking, flashing, and door refinishing <em>(you handle the glass, screens, hardware &amp; interior paint)</em></li>
            <li><strong>Radiant heat under the slab or inside walls</strong> — the in-floor &amp; in-wall pipe components</li>
            <li><strong>Water &amp; sewer pipes inside walls, floors &amp; the slab</strong> — including backups a snake can’t clear</li>
            <li><strong>Electrical &amp; gas lines inside walls and floors</strong></li>
            <li><strong>Fences</strong> — perimeter fencing, plus the structure &amp; exterior of patio fences &amp; gates</li>
            <li><strong>Common landscaping</strong> — shared/front-yard trees, shrubs, planting &amp; irrigation <em>(plants inside your private patio are yours)</em></li>
            <li><strong>Carport &amp; storage structure</strong> — posts, ceiling, walls, and the exterior of the storage door</li>
            <li><strong>Pool, BBQ, community room, playground, private streets &amp; guest parking</strong></li>
          </ul>
          <p class="hoa-foot">You’re generally responsible for everything <em>inside</em> your unit — fixtures, appliances, interior finishes, your water heater &amp; A/C, breaker panel, and window glass/screens. When in doubt, <a href="https://portal.commoninterest.com/community/new-request" target="_blank" rel="noopener noreferrer">check with management before hiring →</a></p>
          <p class="hoa-src">Source: Pomeroy West CC&amp;Rs — Exhibit E, Maintenance Responsibility Chart.</p>
        </div>
      </details>

      <p class="result-count" id="result-count" aria-live="polite">Showing all {count} vendors</p>

      <div class="list" id="list">
        {vendors.map((v) => (
          <article class="vendor" id={v.slug} data-search={searchString(v)} data-cats={v.categories.map((c) => c.label).join('||')}>
            <div class="v-head">
              {v.logo && <img class="v-logo" src={v.logo} alt="" width="44" height="44" loading="lazy" />}
              <div class="v-id">
                <div class="card-cats">
                  {v.categories.map((c) => <span class="cat-badge"><span aria-hidden="true">{c.icon}</span> {c.label}</span>)}
                </div>
                <h2><a href={`#${v.slug}`}>{v.name}</a></h2>
                {v.contact && <p class="contact-name">{v.contact}</p>}
              </div>
              {v.reviewCount > 0 && (
                <span class="reviews-pill" title={`${v.reviewCount} neighbor review${v.reviewCount === 1 ? '' : 's'}, most recent ${v.lastReviewedYear}`}>
                  <span class="star" aria-hidden="true">★</span> {v.reviewCount}{v.lastReviewedYear ? ` · ${v.lastReviewedYear}` : ''}
                </span>
              )}
            </div>

            <div class="reach">
              <span class="reach-primary">
                {v.phones[0]?.href ? (
                  <Fragment>
                    <a class="phone" href={`tel:${v.phones[0].href}`}><Fragment set:html={phoneIcon} /> {v.phones[0].display}</a>
                    {v.smsHref && <a class="text-link" href={`sms:${v.smsHref}`}>Text</a>}
                  </Fragment>
                ) : v.emails[0] ? (
                  <a class="phone" href={`mailto:${v.emails[0]}`}>✉ Email</a>
                ) : null}
              </span>
              <span class="reach-secondary">
                {v.phones[0]?.href && v.emails[0] && <a href={`mailto:${v.emails[0]}`}>✉ Email</a>}
                {v.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
              </span>
            </div>

            {v.services.length > 0 && (
              <div class="tags">
                {v.services.slice(0, 6).map((s) => <span class="tag"><span aria-hidden="true">{s.icon}</span> {s.label}</span>)}
                {v.services.length > 6 && <span class="tag more">+{v.services.length - 6}</span>}
              </div>
            )}

            {v.notes.map((n) => <p class="card-note">ℹ️ {n}</p>)}

            {v.reviews.length > 0 && (
              <div class="v-reviews">
                {v.reviews.slice(0, 3).map((r) => (r.text ? (
                  <blockquote class="review">
                    <p class="review-text">“{r.text}”</p>
                    <cite>{r.source
                      ? <a class="review-src" href={r.source} target="_blank" rel="noopener noreferrer" title="View this recommendation in the Pomeroy West Google Group (members only)">— {r.by || 'A Pomeroy West neighbor'}{r.date ? `, ${r.date}` : ''} ↗</a>
                      : <span>— {r.by || 'A Pomeroy West neighbor'}{r.date ? `, ${r.date}` : ''}</span>}</cite>
                  </blockquote>
                ) : (
                  <p class="mention">{r.source
                    ? <a class="review-src" href={r.source} target="_blank" rel="noopener noreferrer" title="View this mention in the Pomeroy West Google Group (members only)">👋 Mentioned by {r.by || 'a neighbor'}{r.date ? `, ${r.date}` : ''} ↗</a>
                    : <span>👋 Mentioned by {r.by || 'a neighbor'}{r.date ? `, ${r.date}` : ''}</span>}</p>
                )))}
                {v.reviews.length > 3 && (
                  <Fragment>
                    <div class="more-reviews" hidden>
                      {v.reviews.slice(3).map((r) => (r.text ? (
                        <blockquote class="review">
                          <p class="review-text">“{r.text}”</p>
                          <cite>{r.source
                            ? <a class="review-src" href={r.source} target="_blank" rel="noopener noreferrer">— {r.by || 'A Pomeroy West neighbor'}{r.date ? `, ${r.date}` : ''} ↗</a>
                            : <span>— {r.by || 'A Pomeroy West neighbor'}{r.date ? `, ${r.date}` : ''}</span>}</cite>
                        </blockquote>
                      ) : (
                        <p class="mention">{r.source
                          ? <a class="review-src" href={r.source} target="_blank" rel="noopener noreferrer">👋 Mentioned by {r.by || 'a neighbor'}{r.date ? `, ${r.date}` : ''} ↗</a>
                          : <span>👋 Mentioned by {r.by || 'a neighbor'}{r.date ? `, ${r.date}` : ''}</span>}</p>
                      )))}
                    </div>
                    <button class="more-toggle" type="button">Show {v.reviews.length - 3} more review{v.reviews.length - 3 === 1 ? '' : 's'} ▾</button>
                  </Fragment>
                )}
              </div>
            )}
          </article>
        ))}
      </div>

      <p class="empty" id="empty">No vendors match that search. Try a broader term or tap “All vendors”.</p>
    </main>
  </div>

  <script>
    const search = document.getElementById('search');
    const list = document.getElementById('list');
    const cards = Array.from(list.querySelectorAll('.vendor'));
    const chips = Array.from(document.querySelectorAll('.chip'));
    const countEl = document.getElementById('result-count');
    const emptyEl = document.getElementById('empty');
    const filters = document.getElementById('filters');
    const toggle = document.getElementById('filter-toggle');
    const filterLabel = document.getElementById('filter-label');
    let activeCat = 'all';

    const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    function apply() {
      const q = search.value.trim().toLowerCase();
      // Each query word must prefix-match a word in the vendor's blob — which now spans
      // name, contact, trades, services, problem-word synonyms, and neighbor review text.
      // Plain and predictable: handles plurals (cleaner↔cleaners) and multi-word AND.
      const terms = q ? q.split(/\s+/).filter(Boolean).map((t) => new RegExp('\\b' + escapeRe(t), 'i')) : null;
      let shown = 0;
      for (const card of cards) {
        const matchCat = activeCat === 'all' || card.dataset.cats.split('||').includes(activeCat);
        const matchText = !terms || terms.every((re) => re.test(card.dataset.search));
        const visible = matchCat && matchText;
        card.hidden = !visible;
        if (visible) shown++;
      }
      emptyEl.style.display = shown === 0 ? 'block' : 'none';
      countEl.textContent = (q || activeCat !== 'all')
        ? `Showing ${shown} of ${cards.length} vendors`
        : `Showing all ${cards.length} vendors`;
    }

    function closeFilters() { filters.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }

    search.addEventListener('input', apply);

    toggle.addEventListener('click', () => {
      const open = filters.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeCat = chip.dataset.cat;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        filterLabel.textContent = chip.dataset.label;
        closeFilters();
        apply();
      });
    }

    // Close the mobile filter dropdown when tapping outside it
    document.addEventListener('click', (e) => {
      if (filters.classList.contains('open') && !filters.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
        closeFilters();
      }
    });

    // Expand extra reviews in place
    for (const btn of document.querySelectorAll('.more-toggle')) {
      btn.addEventListener('click', () => { btn.previousElementSibling.hidden = false; btn.remove(); });
    }

    // Deep-link: scroll to + highlight a vendor when the URL has #slug
    function jumpToHash() {
      if (!location.hash) return;
      const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (!el) return;
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.classList.add('flash');
      setTimeout(() => el.classList.remove('flash'), 2000);
    }
    window.addEventListener('hashchange', jumpToHash);
    jumpToHash();
  </script>
</Base>
